            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Conflicto de DNI, no de cupo\", () => pm.expect(pm.response.json().detail).to.include(\"ya tiene\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 - Comprobar cupo tras duplicado",
      "request": {
        "method": "GET",
        "header": [],

      "name": "15 - Comprobar restitucion unica",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/eventos/{{evento_demo_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Solo una vacante restituida\", () => pm.expect(pm.response.json().vacantes_disponibles).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 - Rechazar DNI duplicado con cupo disponible",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/eventos/{{evento_demo_id}}/inscripciones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": {\n    \"dni\": \"90000111\",\n    \"nombre_completo\": \"Demo Postman\",\n    \"email\": \"demo.postman@example.com\",\n    \"conocimientos\": [\n      \" MongoDB \",\n      \"DOCKER\"\n    ]\n  },\n  \"actividades_seleccionadas\": [\n    \"ACT-01\"\n  ],\n  \"tipo_entrada\": \"general\"\n}",
          "options": {

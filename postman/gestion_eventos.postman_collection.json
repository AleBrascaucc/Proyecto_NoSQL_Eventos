      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/eventos",
        "body": {
          "mode": "raw",
          "raw": "{{evento_payload}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const inicio = new Date(Date.now() + 30 * 86400000);",
              "const fin = new Date(inicio.getTime() + 2 * 3600000);",
              "const evento = {",
              " titulo: \"Demo Postman \" + inicio.toISOString(), categoria: \"Tecnología\",",
